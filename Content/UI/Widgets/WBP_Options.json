{
    "WidgetName": "WBP_Options",
    "ParentClass": "CommonActivatableWidget",
    "Root": "Border_Window",
    "Size": [
        720,
        640
    ],
    "Alignment": "Center",
    "Title": "PARAM\u00c8TRES DU JEU",
    "Settings": [
        {
            "ID": "Setting_GraphicsPreset",
            "Label": "Pr\u00e9r\u00e9glage Graphique",
            "Type": "RadioSelect",
            "Options": [
                "Cin\u00e9matographique (Lumen HWRT + Nanite)",
                "\u00c9pique (VSM + TSR)",
                "\u00c9quilibr\u00e9 (60 FPS Fixe)"
            ],
            "DefaultIndex": 0
        },
        {
            "ID": "Setting_MouseSens",
            "Label": "Sensibilit\u00e9 Souris",
            "Type": "Slider",
            "Range": [
                0.1,
                3.0
            ],
            "DefaultValue": 1.0,
            "Step": 0.05
        },
        {
            "ID": "Setting_FOV",
            "Label": "Champ de Vision (FOV)",
            "Type": "Slider",
            "Range": [
                75.0,
                105.0
            ],
            "DefaultValue": 85.0,
            "Step": 1.0,
            "Unit": "\u00b0"
        },
        {
            "ID": "Setting_HeadBob",
            "Label": "Mouvement de T\u00eate (Head Bob)",
            "Type": "ToggleSwitch",
            "DefaultValue": true,
            "Description": "Oscillation douce naturelle lors de la marche et du sprint"
        },
        {
            "ID": "Setting_MasterVolume",
            "Label": "Volume G\u00e9n\u00e9ral",
            "Type": "Slider",
            "Range": [
                0.0,
                1.0
            ],
            "DefaultValue": 0.8,
            "Step": 0.05,
            "DisplayPercent": true
        }
    ],
    "FooterButtons": [
        {
            "ID": "Btn_Apply",
            "Text": "APPLIQUER LES MODIFICATIONS",
            "Action": "ApplySettings()"
        },
        {
            "ID": "Btn_Close",
            "Text": "RETOUR",
            "Action": "CloseWidget()"
        }
    ]
}